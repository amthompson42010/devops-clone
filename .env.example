# ---------------------------------------------------------------------------
# Storage
#   local -> everything is stored on disk in LOCAL_STORAGE_DIR (no Azure needed)
#   azure -> everything is stored in Azure Blob Storage
# If STORAGE is not set: uses azure when a connection string is present, otherwise local.
# ---------------------------------------------------------------------------
STORAGE=local
LOCAL_STORAGE_DIR=.data

# Azure Storage connection string (Portal > Storage account > Access keys).
# Only used when STORAGE=azure.
AZURE_STORAGE_CONNECTION_STRING=

# Container names (folders when STORAGE=local; created automatically)
DATA_CONTAINER=devops-data
REPO_CONTAINER=devops-repos

# Server
PORT=4000
# Public base URL used to build git clone URLs (defaults to the request host)
PUBLIC_URL=http://localhost:4000

# Local working cache for bare git repos (rebuilt from storage if deleted)
GIT_CACHE_DIR=.git-cache

# Optional: require HTTP basic auth for git clone/push (leave blank to disable)
GIT_HTTP_USER=
GIT_HTTP_PASSWORD=
